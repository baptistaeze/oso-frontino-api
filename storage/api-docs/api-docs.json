        "/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register and get Bearer token",
                "operationId": "auth.register",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ]
                            },
                            "example": {
                                "name": "John Doe",
                                "email": "john@example.com",
                                "password": "password123",
                                "password_confirmation": "password123"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User registered, token returned",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "user": {
                                        "id": 1,
                                        "name": "John Doe",
                                        "email": "john@example.com"
                                    },
                                    "token": "1|abc123...",
                                    "tokenType": "Bearer"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login and get Bearer token",
                "operationId": "auth.login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ]
                            },
                            "example": {
                                "email": "john@example.com",
                                "password": "password123"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful, token returned",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "user": {
                                        "id": 1,
                                        "name": "John Doe",
                                        "email": "john@example.com"
                                    },
                                    "token": "1|abc123...",
                                    "tokenType": "Bearer"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
